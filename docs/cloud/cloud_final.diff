+"""Verified labels for incidents and export for retraining (lab/train.py --extra).
+
+Only two sources are accepted: the scenario truth and a manual correction.
+Edge output is never a label. Manual labels override scenario labels.
+"""
+
+from __future__ import annotations
+
+import json
+from datetime import datetime, timezone
+
+from . import readings as rd
+
+FIRE_CLASSES = ("slow_fire", "fast_fire")
+NON_FIRE_CLASSES = ("normal", "dust", "fog", "direct_sun")
+BASE_MS = 1784073600000  # 2026-07-15T00:00:00Z, clock of the scenario files
+PRE_MS = 600_000  # clean "normal" context kept this long before the first alarm
+MARGIN_MS = 120_000
+SCENARIO_CLASS = {
+    "fuego_lento": ("correct", "slow_fire"),
+    "fuego_rapido": ("correct", "fast_fire"),
+    "polvo_tractor": ("incorrect", "dust"),
+    "niebla": ("incorrect", "fog"),
+    "sol_directo": ("incorrect", "direct_sun"),
+}
+
+
+def _now():
+    return datetime.now(timezone.utc).isoformat()
+
+
+def check_label(label, true_class):
+    if label == "correct":
+        return true_class if true_class in FIRE_CLASSES else None
+    if label == "incorrect":
+        return true_class or "normal" if (true_class or "normal") in NON_FIRE_CLASSES else None
+    return None
+
+
+def set_label(conn, incident_id, label, true_class, source):
+    cls = check_label(label, true_class)
+    if (
+        cls is None
+        or source not in ("scenario", "manual")
+        or not isinstance(incident_id, str)
+        or not 0 < len(incident_id) <= 64
+    ):
+        raise ValueError("invalid label")
+    conn.execute(
+        "INSERT OR REPLACE INTO labels(incident_id,label,true_class,source,created_at) "
+        "VALUES (?,?,?,?,?)",
+        (incident_id, label, cls, source, _now()),
+    )
+    return cls
+
+
+def effective(conn):
+    """incident_id -> (label, class, source); manual wins over scenario."""
+    out = {}
+    for row in conn.execute(
+        "SELECT incident_id,label,true_class,source FROM labels "
+        "ORDER BY CASE source WHEN 'scenario' THEN 0 ELSE 1 END"
+    ):
+        out[row["incident_id"]] = (row["label"], row["true_class"], row["source"])
+    return out
+
+
+def save_truth(conn, run_id, truth):
+    if not isinstance(run_id, str) or not 0 < len(run_id) <= 128:
+        raise ValueError("run_id")
+    if not isinstance(truth, dict) or truth.get("escenario") not in SCENARIO_CLASS and (
+        truth.get("alarma_esperada") is not False
+    ):
+        raise ValueError("unsupported scenario truth")
+    conn.execute(
+        "INSERT OR REPLACE INTO truth(run_id,payload_json) VALUES (?,?)",
+        (run_id, json.dumps(truth, sort_keys=True)),
+    )
+
+
+def label_from_truth(conn, incidents):
+    """Label every incident of runs with stored truth. Returns number labelled."""
+    done = 0
+    for item in incidents:
+        row = conn.execute(
+            "SELECT payload_json FROM truth WHERE run_id=?", (item["run_id"],)
+        ).fetchone()
+        if row is None:
+            continue
+        truth = json.loads(row["payload_json"])
+        name = truth.get("escenario")
+        t0_ms = BASE_MS + int(truth.get("t0_s", 0)) * 1000
+        first_ms = rd._ts_ms(item["first_seen"])
+        if truth.get("alarma_esperada") and name in SCENARIO_CLASS and first_ms >= t0_ms:
+            label, cls = SCENARIO_CLASS[name]
+        else:  # alarm without fire (dust, fog, sun, or before the fire started)
+            label, cls = "incorrect", SCENARIO_CLASS.get(name, ("", "normal"))[1]
+            if cls in FIRE_CLASSES:
+                cls = "normal"
+        set_label(conn, item["incident_id"], label, cls, "scenario")
+        done += 1
+    return done
+
+
+def training_rows(conn, incidents):
+    """Yield one reviewed-train record per labelled reading.
+
+    Fire/other class applies from each node's first alarm (minus a small margin
+    for non-fire) to its last alarm + margin. Readings more than PRE_MS before
+    the first alarm are clean 'normal' context; the gap in between is skipped
+    because it is ambiguous. Message format is the Edge's schema v1.
+    """
+    labels = effective(conn)
+    for item in incidents:
+        if item["incident_id"] not in labels:
+            continue
+        label, cls, _ = labels[item["incident_id"]]
+        run = item["run_id"]
+        last_ms = rd._ts_ms(item["last_seen"])
+        for step in item["timeline"]:
+            first = rd._ts_ms(step["first_alarm"])
+            lo = first if label == "correct" else first - MARGIN_MS
+            for r in conn.execute(
+                "SELECT * FROM readings WHERE run_id=? AND node_id=? ORDER BY ts_ms, seq",
+                (run, step["node"]),
+            ):
+                t = r["ts_ms"]
+                if lo <= t <= last_ms + MARGIN_MS:
+                    klass = cls
+                elif t < first - PRE_MS:
+                    klass = "normal"
+                else:
+                    continue
+                yield {
+                    "group": f"reviewed-train-{run}",
+                    "class": klass,
+                    "message": {
+                        "schema_version": 1,
+                        "type": "reading",
+                        "run_id": run,
+                        "node_id": r["node_id"],
+                        "seq": r["seq"],
+                        "timestamp": datetime.fromtimestamp(
+                            t / 1000, timezone.utc
+                        ).isoformat(),
+                        "timebase": "simulated",
+                        "boot_id": r["boot_id"],
+                        "measurements": {
+                            "pm25_ug_m3": r["pm25"],
+                            "pm10_ug_m3": r["pm10"],
+                            "air_temperature_c": r["temperature"],
+                            "relative_humidity_pct": r["humidity"],
+                        },
+                    },
+                }
diff --git a/demos/edge1000-v4/cloud/readings.py b/demos/edge1000-v4/cloud/readings.py
new file mode 100644
index 0000000..51bbd21
--- /dev/null
+++ b/demos/edge1000-v4/cloud/readings.py
@@ -0,0 +1,254 @@
+"""Reading batches from the Edge: sliding-window store plus Cloud-side tables.
+
+Alerts stay the immutable event log. Readings are a bounded window used for the
+panel, incident peaks and (with labels) retraining. Dedup key: (run, node, boot, seq).
+"""
+
+from __future__ import annotations
+
+import json
+import math
+from datetime import datetime, timezone
+
+READINGS_TOPIC = "wildfiresense/edge/evidence"
+MAX_BATCH_BYTES = 1 << 20
+MAX_BATCH_READINGS = 5000
+WINDOW_S = 6 * 3600
+FIELDS = ("PM2.5", "PM10", "temperature", "humidity")
+
+SCHEMA = (
+    """CREATE TABLE IF NOT EXISTS readings (
+        run_id TEXT NOT NULL,
+        node_id TEXT NOT NULL,
+        boot_id TEXT NOT NULL,
+        seq INTEGER NOT NULL,
+        ts_ms INTEGER NOT NULL,
+        kind TEXT NOT NULL,
+        pm25 REAL, pm10 REAL, temperature REAL, humidity REAL,
+        batch_id TEXT NOT NULL,
+        PRIMARY KEY (run_id, node_id, boot_id, seq)
+    )""",
+    "CREATE INDEX IF NOT EXISTS idx_readings_time ON readings(run_id, ts_ms)",
+    "CREATE INDEX IF NOT EXISTS idx_readings_node ON readings(run_id, node_id, ts_ms)",
+    """CREATE TABLE IF NOT EXISTS labels (
+        incident_id TEXT NOT NULL,
+        label TEXT NOT NULL CHECK (label IN ('correct', 'incorrect')),
+        true_class TEXT,
+        source TEXT NOT NULL CHECK (source IN ('scenario', 'manual')),
+        created_at TEXT NOT NULL,
+        PRIMARY KEY (incident_id, source)
+    )""",
+    """CREATE TABLE IF NOT EXISTS nodes (
+        node_id TEXT PRIMARY KEY,
+        zone TEXT NOT NULL,
+        x INTEGER NOT NULL,
+        y INTEGER NOT NULL
+    )""",
+    """CREATE TABLE IF NOT EXISTS truth (
+        run_id TEXT PRIMARY KEY,
+        payload_json TEXT NOT NULL
+    )""",
+    """CREATE TABLE IF NOT EXISTS models (
+        version TEXT PRIMARY KEY,
+        status TEXT NOT NULL CHECK (status IN ('active', 'candidate', 'previous', 'rejected')),
+        metrics_json TEXT,
+        created_at TEXT NOT NULL
+    )""",
+    """CREATE TABLE IF NOT EXISTS retrain_runs (
+        id INTEGER PRIMARY KEY AUTOINCREMENT,
+        started_at TEXT NOT NULL,
+        finished_at TEXT,
+        trigger TEXT NOT NULL,
+        labels_used INTEGER,
+        result TEXT,
+        model_version TEXT
+    )""",
+)
+
+
+GRID_WIDTH = 32
+GRID_NODES = 1024
+ZONE_SIZE = 4
+
+
+def grid_position(node):
+    """node_0496 -> (zone, x, y) on the 32x32 grid, or None outside it."""
+    name = node_name(node)
+    if name is None or not 1 <= int(name[5:]) <= GRID_NODES:
+        return None
+    idx = int(name[5:]) - 1
+    x, y = idx % GRID_WIDTH, idx // GRID_WIDTH
+    return f"z_{y // ZONE_SIZE}_{x // ZONE_SIZE}", x, y
+
+
+def create_tables(conn):
+    for statement in SCHEMA:
+        conn.execute(statement)
+    if conn.execute("SELECT COUNT(*) FROM nodes").fetchone()[0] != GRID_NODES:
+        for n in range(1, GRID_NODES + 1):
+            name = f"node_{n:04d}"
+            zone, x, y = grid_position(name)
+            conn.execute(
+                "INSERT OR IGNORE INTO nodes(node_id,zone,x,y) VALUES (?,?,?,?)",
+                (name, zone, x, y),
+            )
+
+
+def node_name(raw):
+    """Accepts 496, "496" or "node_0496"; returns "node_0496" or None."""
+    if isinstance(raw, bool):
+        return None
+    if isinstance(raw, str) and raw.startswith("node_"):
+        raw = raw[5:]
+    try:
+        num = int(raw)
+    except (TypeError, ValueError):
+        return None
+    return f"node_{num:04d}" if 1 <= num <= 9999 else None
+
+
+def _ts_ms(value):
+    if isinstance(value, bool):
+        return None
+    if isinstance(value, (int, float)):
+        return int(value) if math.isfinite(value) and value > 0 else None
+    if isinstance(value, str):
+        try:
+            dt = datetime.fromisoformat(value.replace("Z", "+00:00"))
+        except ValueError:
+            return None
+        if dt.tzinfo is None:
+            dt = dt.replace(tzinfo=timezone.utc)
+        return int(dt.timestamp() * 1000)
+    return None
+
+
+def _number(value):
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        return None
+    return float(value) if math.isfinite(value) else None
+
+
+def parse_batch(payload):
+    """Returns (batch_id, run_id, rows) or raises ValueError on a malformed batch."""
+    if not isinstance(payload, bytes) or not 0 < len(payload) <= MAX_BATCH_BYTES:
+        raise ValueError("size")
+    try:
+        data = json.loads(payload.decode("utf-8"))
+    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
+        raise ValueError("json") from exc
+    if not isinstance(data, dict):
+        raise ValueError("shape")
+    batch_id = data.get("batch_id")
+    run_id = data.get("run_id", "default")
+    items = data.get("readings")
+    if (
+        not isinstance(batch_id, str)
+        or not 0 < len(batch_id) <= 128
+        or not isinstance(run_id, str)
+        or not 0 < len(run_id) <= 128
+        or not isinstance(items, list)
+        or len(items) > MAX_BATCH_READINGS
+    ):
+        raise ValueError("fields")
+    rows = []
+    for item in items:
+        if not isinstance(item, dict):
+            raise ValueError("reading")
+        node = node_name(item.get("id", item.get("node_id")))
+        ts = _ts_ms(item.get("ts"))
+        seq = item.get("seq")
+        boot = item.get("boot_id", "default")
+        values = item.get("values")
+        kind = item.get("kind", "periodic")
+        if (
+            node is None
+            or ts is None
+            or isinstance(seq, bool)
+            or not isinstance(seq, int)
+            or seq < 0
+            or not isinstance(boot, str)
+            or not 0 < len(boot) <= 64
+            or not isinstance(kind, str)
+            or not isinstance(values, dict)
+        ):
+            raise ValueError("reading")
+        numbers = [_number(values.get(f)) for f in FIELDS]
+        if all(n is None for n in numbers):
+            raise ValueError("reading")
+        rows.append((run_id, node, boot, seq, ts, kind[:32], *numbers, batch_id))
+    return batch_id, run_id, rows
+
+
+def ingest_batch(conn, payload, window_s=WINDOW_S):
+    """Returns (result, batch_id, inserted, duplicates).
+
+    result is inserted|duplicate|invalid. A repeated batch is a delivered
+    duplicate (safe to ACK); readings are deduplicated individually.
+    """
+    try:
+        batch_id, run_id, rows = parse_batch(payload)
+    except ValueError:
+        return "invalid", None, 0, 0
+    inserted = 0
+    for row in rows:
+        inserted += conn.execute(
+            """INSERT OR IGNORE INTO readings
+               (run_id,node_id,boot_id,seq,ts_ms,kind,pm25,pm10,temperature,humidity,batch_id)
+               VALUES (?,?,?,?,?,?,?,?,?,?,?)""",
+            row,
+        ).rowcount
+    if rows:
+        conn.execute(
+            "DELETE FROM readings WHERE run_id=? AND ts_ms < "
+            "(SELECT MAX(ts_ms) FROM readings WHERE run_id=?) - ?",
+            (run_id, run_id, int(window_s * 1000)),
+        )
+    duplicates = len(rows) - inserted
+    return ("inserted" if inserted or not rows else "duplicate"), batch_id, inserted, duplicates
+
+
+def query(conn, run_id=None, node_id=None, since_ms=None, until_ms=None, limit=500):
+    where, args = [], []
+    for column, value in (("run_id", run_id), ("node_id", node_id)):
+        if value is not None:
+            where.append(f"{column} = ?")
+            args.append(value)
+    if since_ms is not None:
+        where.append("ts_ms >= ?")
+        args.append(since_ms)
+    if until_ms is not None:
+        where.append("ts_ms <= ?")
+        args.append(until_ms)
+    sql = (
+        "SELECT run_id,node_id,boot_id,seq,ts_ms,kind,pm25,pm10,temperature,humidity "
+        "FROM readings"
+        + (" WHERE " + " AND ".join(where) if where else "")
+        + " ORDER BY ts_ms DESC LIMIT ?"
+    )
+    args.append(max(1, min(1000, int(limit))))
+    return [dict(r) for r in conn.execute(sql, args).fetchall()]
+
+
+def peak_pm25(conn, run_id, nodes, start_ms, end_ms):
+    if not nodes:
+        return None
+    marks = ",".join("?" for _ in nodes)
+    row = conn.execute(
+        f"SELECT MAX(pm25) FROM readings WHERE run_id=? AND node_id IN ({marks}) "
+        "AND ts_ms BETWEEN ? AND ?",
+        (run_id, *nodes, start_ms, end_ms),
+    ).fetchone()
+    return row[0] if row else None
+
+
+def counts(conn):
+    row = conn.execute(
+        "SELECT COUNT(*), COUNT(DISTINCT node_id), MIN(ts_ms), MAX(ts_ms) FROM readings"
+    ).fetchone()
+    return dict(
+        stored_readings=row[0],
+        reading_nodes=row[1],
+        window_from_ms=row[2],
+        window_to_ms=row[3],
+    )
diff --git a/demos/edge1000-v4/cloud/retrain.py b/demos/edge1000-v4/cloud/retrain.py
new file mode 100644
index 0000000..c20633f
--- /dev/null
+++ b/demos/edge1000-v4/cloud/retrain.py
@@ -0,0 +1,208 @@
+"""Retraining on verified labels, synthetic gate, model registry and rollback.
+
+Trigger: N new labels since the last run. Candidates never go live on their own:
+promotion is explicit (button or API), and only for candidates that passed the gate.
+Rollback restores the previous registered version.
+"""
+
+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+import threading
+from datetime import datetime, timezone
+from pathlib import Path
+
+from edge.model import ROOT
+
+TRIGGER_LABELS = 10
+STATUSES = ("active", "candidate", "previous", "rejected")
+
+
+def _now():
+    return datetime.now(timezone.utc).isoformat()
+
+
+def _subprocess_train(extra, output):
+    subprocess.run(
+        [sys.executable, "-m", "lab.train", "--output", str(output), "--extra", str(extra)],
+        cwd=ROOT, check=True, capture_output=True, timeout=3600,
+    )
+
+
+def _subprocess_gate(candidate, baseline, report):
+    # The gate exits non-zero when it rejects; the report is written either way.
+    subprocess.run(
+        [sys.executable, "-m", "lab.model_gate", "--candidate", str(candidate),
+         "--baseline", str(baseline), "--out", str(report)],
+        cwd=ROOT, capture_output=True, timeout=3600,
+    )
+    return json.loads(Path(report).read_text(encoding="utf-8"))
+
+
+def _scenario_check(candidate, baseline):
+    """The team's nine scenarios: the candidate must not regress against the deployed model."""
+    from lab.scenario_gate import DEFAULT_DIR, compare
+
+    if not DEFAULT_DIR.exists():
+        return dict(approved=True, skipped="scenarios_unavailable")
+    return compare(Path(candidate), Path(baseline))
+
+
+def _version(path):
+    return json.loads(Path(path).read_text(encoding="utf-8"))["version"]
+
+
+def _promote(candidate, target):
+    from lab.promote import promote
+
+    promote(Path(candidate), Path(target))
+
+
+class Retrainer:
+    def __init__(self, store, work_dir, model_path=None, trigger_labels=TRIGGER_LABELS,
+                 train_fn=_subprocess_train, gate_fn=_subprocess_gate, promote_fn=_promote,
+                 scenario_fn=_scenario_check):
+        self.store = store
+        self.work_dir = Path(work_dir)
+        self.work_dir.mkdir(parents=True, exist_ok=True)
+        self.model_path = Path(model_path or ROOT / "models/forest.json")
+        self.trigger_labels = trigger_labels
+        self.train_fn, self.gate_fn, self.promote_fn = train_fn, gate_fn, promote_fn
+        self.scenario_fn = scenario_fn
+        self.lock = threading.Lock()
+        with store.connect() as conn:
+            if conn.execute("SELECT COUNT(*) FROM models").fetchone()[0] == 0:
+                conn.execute(
+                    "INSERT INTO models(version,status,metrics_json,created_at) VALUES (?,?,?,?)",
+                    (_version(self.model_path), "active", None, _now()),
+                )
+
+    # --- state -----------------------------------------------------------
+    def pending_labels(self):
+        with self.store.connect() as conn:
+            last = conn.execute("SELECT MAX(started_at) FROM retrain_runs").fetchone()[0]
+            if last is None:
+                return conn.execute("SELECT COUNT(*) FROM labels").fetchone()[0]
+            return conn.execute(
+                "SELECT COUNT(*) FROM labels WHERE created_at > ?", (last,)
+            ).fetchone()[0]
+
+    def state(self):
+        with self.store.connect() as conn:
+            models = [dict(r) for r in conn.execute(
+                "SELECT version,status,metrics_json,created_at FROM models ORDER BY created_at DESC")]
+            runs = [dict(r) for r in conn.execute(
+                "SELECT * FROM retrain_runs ORDER BY id DESC LIMIT 20")]
+        for m in models:
+            m["metrics"] = json.loads(m.pop("metrics_json") or "null")
+        return dict(models=models, runs=runs, pending_labels=self.pending_labels(),
+                    trigger_labels=self.trigger_labels, running=self.lock.locked())
+
+    # --- retraining ------------------------------------------------------
+    def maybe_trigger(self):
+        """Start a background run when enough new verified labels exist."""
+        if self.lock.locked() or self.pending_labels() < self.trigger_labels:
+            return False
+        threading.Thread(target=self.run, args=("labels",), daemon=True).start()
+        return True
+
+    def run(self, trigger="manual"):
+        if not self.lock.acquire(blocking=False):
+            return dict(result="busy")
+        try:
+            used = self.pending_labels()
+            with self.store.connect() as conn:
+                run_id = conn.execute(
+                    "INSERT INTO retrain_runs(started_at,trigger,labels_used) VALUES (?,?,?)",
+                    (_now(), trigger, used),
+                ).lastrowid
+            result, version = self._execute(run_id)
+            with self.store.connect() as conn:
+                conn.execute(
+                    "UPDATE retrain_runs SET finished_at=?,result=?,model_version=? WHERE id=?",
+                    (_now(), result, version, run_id),
+                )
+            return dict(result=result, model_version=version, run_id=run_id)
+        finally:
+            self.lock.release()
+
+    def _execute(self, run_id):
+        extra = self.work_dir / f"extra_{run_id}.jsonl"
+        if self.store.export_training(extra) == 0:
+            return "no_data", None
+        candidate = self.work_dir / f"candidate_{run_id}.json"
+        try:
+            self.train_fn(extra, candidate)
+            version = _version(candidate)
+            report = self.gate_fn(candidate, self.model_path, self.work_dir / f"gate_{run_id}.json")
+            scenarios = self.scenario_fn(candidate, self.model_path)
+        except Exception as exc:  # noqa: BLE001 - recorded, never fatal for the Cloud
+            return f"error: {type(exc).__name__}", None
+        final = self.work_dir / f"forest.{version}.json"
+        candidate.replace(final)
+        reasons = list(report.get("reasons") or [])
+        if not scenarios.get("approved"):
+            reasons += [f"scenario_regression:{n}" for n in scenarios.get("regressions", [])]
+        approved = (
+            bool(report.get("approved"))
+            and bool(scenarios.get("approved"))
+            and not report.get("same_version")
+        )
+        status = "candidate" if approved else "rejected"
+        passed = scenarios.get("candidate", {})
+        metrics = dict(approved=approved, reasons=reasons,
+                       scenarios=dict(passed=passed.get("passed"), total=passed.get("total"),
+                                      failed=passed.get("failed"), skipped=scenarios.get("skipped")),
+                       baseline=report.get("baseline_model"),
+                       candidate=report.get("candidate"), reference=report.get("baseline"))
+        with self.store.connect() as conn:
+            conn.execute(
+                "INSERT OR REPLACE INTO models(version,status,metrics_json,created_at) VALUES (?,?,?,?)",
+                (version, status, json.dumps(metrics), _now()),
+            )
+        return ("candidate" if approved else "rejected"), version
+
+    # --- promotion and rollback -------------------------------------------
+    def _active(self, conn):
+        row = conn.execute("SELECT version FROM models WHERE status='active'").fetchone()
+        return row[0] if row else None
+
+    def promote(self, version):
+        with self.store.connect() as conn:
+            row = conn.execute("SELECT status FROM models WHERE version=?", (version,)).fetchone()
+            if row is None or row[0] != "candidate":
+                raise ValueError("only gate-approved candidates can be promoted")
+            old = self._active(conn)
+        if old:
+            keep = self.work_dir / f"forest.{old}.json"
+            if not keep.exists() and self.model_path.exists():
+                keep.write_bytes(self.model_path.read_bytes())
+        self.promote_fn(self.work_dir / f"forest.{version}.json", self.model_path)
+        with self.store.connect() as conn:
+            conn.execute("UPDATE models SET status='candidate' WHERE status='previous'")
+            if old:
+                conn.execute("UPDATE models SET status='previous' WHERE version=?", (old,))
+            conn.execute("UPDATE models SET status='active' WHERE version=?", (version,))
+        return version
+
+    def rollback(self):
+        with self.store.connect() as conn:
+            prev = conn.execute(
+                "SELECT version FROM models WHERE status='previous' ORDER BY created_at DESC LIMIT 1"
+            ).fetchone()
+            current = self._active(conn)
+        if prev is None:
+            raise ValueError("no previous model to restore")
+        version = prev[0]
+        source = self.work_dir / f"forest.{version}.json"
+        if not source.exists():
+            source = self.model_path.with_name(f"forest.{version}.json")
+        if not source.exists():
+            raise ValueError("previous model file is missing")
+        self.promote_fn(source, self.model_path)
+        with self.store.connect() as conn:
+            conn.execute("UPDATE models SET status='candidate' WHERE version=?", (current,))
+            conn.execute("UPDATE models SET status='active' WHERE version=?", (version,))
+        return version
diff --git a/demos/edge1000-v4/docs/CLOUD_CONTRATO_EDGE.md b/demos/edge1000-v4/docs/CLOUD_CONTRATO_EDGE.md
new file mode 100644
index 0000000..7317de6
--- /dev/null
+++ b/demos/edge1000-v4/docs/CLOUD_CONTRATO_EDGE.md
@@ -0,0 +1,41 @@
+# Contrato Edge -> Cloud (Cloud final)
+
+Todo es sintético. El Cloud no decide en tiempo real: guarda, agrupa incidentes, etiqueta, reentrena y valida.
+
+## Mensajes que el Cloud acepta (MQTT, QoS 1)
+| Topic | Contenido | ACK |
+|---|---|---|
+| `wildfiresense/edge/alerts` | Alertas (sin cambios) | `cloud/ack` `{"event_id"}` |
+| `wildfiresense/cloud/analysis` | Resumen por zona (ver abajo). El formato antiguo sin `zone` sigue válido | `cloud/ack` `{"event_id"}` |
+| `wildfiresense/edge/evidence` | Lecturas crudas de los nodos de un incidente (10 min antes y después) | `cloud/ack` `{"event_id": "<batch_id>"}` |
+| `wildfiresense/edge/status`, `edge/ping` | Sin cambios | `cloud/pong` |
+
+### Resumen por zona (`cloud/analysis`)
+Zona = bloque 4x4 de la rejilla 32x32: `z_{y//4}_{x//4}` con `idx = N-1`, `x = idx % 32`, `y = idx // 32`.
+```json
+{"event_id":"...","generated_at":"...","computed_by":"edge",
+ "zone":"z_3_3","from_ts":1784124000000,"to_ts":1784124060000,
+ "n":120,"mean_pm25":12.4,"max_pm25":48.0,"max_node_id":"node_0496"}
+```
+Con `computed_by:"cloud"` se envía `samples: [{"node_id":..,"pm25":..}]` (1..512) y el Cloud calcula.
+
+### Evidencia (`edge/evidence`)
+```json
+{"batch_id":"unico","run_id":"...","readings":[
+ {"id":496,"ts":1784124000000,"seq":12,"boot_id":"a3f1c2d4","kind":"periodic",
+  "values":{"PM2.5":9.4,"PM10":17.8,"temperature":24.1,"humidity":58.3}}]}
+```
+- `id`: entero o `node_0496`. `ts`: ms o ISO. Máximo 1 MiB y 5000 lecturas por mensaje.
+- Deduplicación por `(run_id, node, boot_id, seq)`; reenviar un lote es seguro.
+
+## API HTTP
+`GET /api/stats|alerts|incidents|readings|nodes|zones|models` · `POST /api/labels|truth|retrain|models/promote|models/rollback`.
+- `incidents` incluye `timeline` (orden y segundos de alarma por nodo), `duration_s`, `peak_pm25` y `label`.
+
+## Etiquetas y reentrenamiento
+- Fuentes de etiqueta: verdad del escenario (`POST /api/truth`) o corrección manual (`POST /api/labels`). Nunca la salida del Edge. La manual prevalece.
+- A las N etiquetas nuevas (por defecto 10, `RETRAIN_TRIGGER_LABELS`) se exporta el JSONL revisado, se ejecuta `lab.train --extra` y `lab.model_gate`.
+- Solo un candidato aprobado se puede promover. `rollback` restaura el modelo anterior.
+- El Edge debe recargar `models/forest.json` tras promover o volver atrás.
+- Además del gate sintético, el candidato debe pasar los 9 escenarios de `data/scenarios` (`lab/scenario_gate.py`): no puede fallar ninguno que el modelo desplegado supere.
+- Verificado de punta a punta: entrenamiento real con 42 039 filas exportadas por el Cloud en 29 s; el candidato fue rechazado por el gate (macro-F1, exactitud y retardo) y el modelo activo no cambió.
